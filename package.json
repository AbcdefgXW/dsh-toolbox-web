{
  "name": "dsh-toolbox-web",
  "version": "0.1.16",
  "description": "dsh 工具箱：会话/回收站/子目录/搜索/预设/配置管理 + 定时心跳（IM 渠道推送）+ 长消息折叠 | Toolbox plugin for dsh: session/trash/subdir/search/preset/config management + scheduled heartbeat (IM push) + long-message collapse",
  "type": "module",
  "main": "index.js",
  "dependencies": {
    "js-yaml": "^4.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.0-rc.8": "compatible",
        "0.1.1-rc.2": "compatible"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbcdefgXW/dsh-toolbox-web.git"
  },
  "homepage": "https://github.com/AbcdefgXW/dsh-toolbox-web",
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "assets/"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "plugin",
    "toolbox",
    "session",
    "search",
    "heartbeat",
    "chat",
    "回收站",
    "工具箱",
    "语义搜索"
  ],
  "bugs": {
    "url": "https://github.com/AbcdefgXW/dsh-toolbox-web/issues"
  }
}
